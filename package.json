{
  "name": "lumantite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/schema && npm run build -w packages/catalog -w packages/engine -w packages/project && npm run build -w apps/server -w apps/cli -w apps/mcp -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/web",
    "start": "node apps/server/dist/index.js",
    "build:packages": "npm run build -w packages/schema && npm run build -w packages/catalog -w packages/engine -w packages/project",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
